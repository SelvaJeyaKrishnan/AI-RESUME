# App
APP_NAME=ResumeAI
ENVIRONMENT=development
DEBUG=true

# Security
SECRET_KEY=change-this-to-a-long-random-secret-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Dev (SQLite):
DATABASE_URL=sqlite:///./resumeai.db
# Prod (PostgreSQL) example:
# DATABASE_URL=postgresql://user:password@localhost:5432/resumeai

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# File uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
ALLOWED_EXTENSIONS=.pdf,.docx,.txt

# ML
USE_SEMANTIC_MODEL=true
SEMANTIC_MODEL_NAME=all-MiniLM-L6-v2

# Scoring weights (must sum to 1.0)
WEIGHT_SKILLS=0.40
WEIGHT_EXPERIENCE=0.25
WEIGHT_SEMANTIC=0.20
WEIGHT_EDUCATION=0.10
WEIGHT_KEYWORDS=0.05
